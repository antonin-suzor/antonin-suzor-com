---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../app.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, stripLocaleFromPath } from '../i18n/utils';

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    ogImageAlt?: string;
}

const {
    title = 'Antonin Suzor',
    description = "Antonin Suzor's personal website",
    ogImage,
    ogImageAlt = 'Antonin Suzor',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const pathWithoutLocale = stripLocaleFromPath(Astro.url.pathname);
const canonicalPath = getRelativeLocaleUrl(lang, pathWithoutLocale);
const englishPath = pathWithoutLocale;
const frenchPath = getRelativeLocaleUrl('fr', pathWithoutLocale);

const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath;
const englishUrl = Astro.site ? new URL(englishPath, Astro.site).toString() : englishPath;
const frenchUrl = Astro.site ? new URL(frenchPath, Astro.site).toString() : frenchPath;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg" href="/icon.svg" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="en" href={englishUrl} />
        <link rel="alternate" hreflang="fr" href={frenchUrl} />
        <link rel="alternate" hreflang="x-default" href={englishUrl} />
        {ogImage && <meta property="og:image" content={ogImage} />}
        {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    </head>
    <body class="m-0 h-full bg-psblack p-0 font-main text-tx1">
        <div class="flex min-h-screen flex-col bg-bg1">
            <Header />

            <main class="flex-1">
                <slot />
            </main>

            <Footer />
        </div>
    </body>
</html>
