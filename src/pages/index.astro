---
import myPicture from '../lib/assets/pictures/antonin-suzor.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import { experiences, projects, education } from '../lib/resume';
---

<BaseLayout
    title="Antonin Suzor — Software, Cloud & DevOps Engineer"
    description="Antonin Suzor's professional experiences, projects, and diplomas."
    ogImage={myPicture.src}
>
    <Hero />
    <Timeline title="Professional Experience" id="experience" entries={experiences} variant="onBg2" orgSeparator="@" />
    <Timeline title="Academic & Personal Projects" id="projects" entries={projects} variant="onBg1" orgSeparator="-" />
    <Timeline title="Education & Diplomas" id="education" entries={education} variant="onBg2" orgSeparator="-" />
    <Skills />
    <Contact />
</BaseLayout>
