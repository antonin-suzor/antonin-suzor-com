---
import { getPosts } from '../../i18n/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = getPosts('en');
---

<BaseLayout title="Blog | Antonin Suzor" description="Blog posts by Antonin Suzor.">
    <section class="mx-auto max-w-4xl px-4 py-16">
        <h1 class="mb-6 font-title text-5xl">Blog</h1>
        <ul class="space-y-4">
            {
                posts.map((post) => (
                    <li>
                        <a class="text-2xl underline" href={`/blog/${post.slug}/`}>
                            {post.title}
                        </a>
                        <p class="text-lg">{post.description}</p>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>
