---
import { getPost, getPosts } from '../../../i18n/blog';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
    return getPosts('fr').map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = slug ? getPost('fr', slug) : undefined;

if (!post) {
    throw new Error('Article introuvable');
}
---

<BaseLayout title={`${post.title} | Blog`} description={post.description}>
    <article class="mx-auto max-w-4xl px-4 py-16">
        <h1 class="mb-6 font-title text-5xl">{post.title}</h1>
        <p class="text-xl">{post.content}</p>
    </article>
</BaseLayout>
