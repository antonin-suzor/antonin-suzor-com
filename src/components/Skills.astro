---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Skill {
    name: string;
    logo: string;
}

interface OtherSkill {
    name: string;
    logo: string | ImageMetadata;
}

function isImageMetadata(logo: OtherSkill['logo']): logo is ImageMetadata {
    return typeof logo !== 'string';
}

const softwareSkills: Skill[] = [
    { name: 'Bash', logo: 'https://icon.icepanel.io/Technology/svg/Bash.svg' },
    { name: 'C', logo: 'https://icon.icepanel.io/Technology/svg/C.svg' },
    { name: 'Rust', logo: 'https://icon.icepanel.io/Technology/svg/Rust.svg' },
    { name: 'Java', logo: 'https://icon.icepanel.io/Technology/svg/Java.svg' },
    { name: 'TypeScript', logo: 'https://icon.icepanel.io/Technology/svg/TypeScript.svg' },
    { name: 'Postgres/SQL', logo: 'https://icon.icepanel.io/Technology/svg/PostgresSQL.svg' },
    { name: 'SQLite', logo: 'https://icon.icepanel.io/Technology/svg/SQLite.svg' },
    { name: 'Redis/Valkey', logo: 'https://icon.icepanel.io/Technology/svg/Redis.svg' },
    { name: 'RabbitMQ', logo: 'https://icon.icepanel.io/Technology/svg/RabbitMQ.svg' },
    { name: 'Bun', logo: 'https://icon.icepanel.io/Technology/svg/Bun.svg' },
    { name: 'Drizzle', logo: 'https://avatars.githubusercontent.com/u/108468352?s=200&v=4' },
    { name: 'React', logo: 'https://icon.icepanel.io/Technology/svg/React.svg' },
    { name: 'SvelteKit', logo: 'https://icon.icepanel.io/Technology/svg/Svelte.svg' },
    { name: 'Astro', logo: 'https://icon.icepanel.io/Technology/svg/Astro.svg' },
    { name: 'TailwindCSS', logo: 'https://icon.icepanel.io/Technology/svg/Tailwind-CSS.svg' },
    { name: 'Tauri', logo: 'https://icon.icepanel.io/Technology/svg/Tauri.svg' },
];

const cloudSkills: Skill[] = [
    { name: 'Kubernetes', logo: 'https://icon.icepanel.io/Technology/svg/Kubernetes.svg' },
    { name: 'AWS', logo: 'https://icon.icepanel.io/Technology/svg/AWS.svg' },
    { name: 'GCP', logo: 'https://icon.icepanel.io/Technology/svg/Google-Cloud.svg' },
    { name: 'OVH', logo: 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/ovh.svg' },
    { name: 'Cloudflare/Workers', logo: 'https://icon.icepanel.io/Technology/svg/Cloudflare.svg' },
    { name: 'Terraform', logo: 'https://icon.icepanel.io/Technology/svg/HashiCorp-Terraform.svg' },
    {
        name: 'Terragrunt',
        logo: 'https://seltonfiuza.gallerycdn.vsassets.io/extensions/seltonfiuza/terragrunt-easy-plan/0.1.0/1692128682569/Microsoft.VisualStudio.Services.Icons.Default',
    },
];

const devopsSkills: OtherSkill[] = [
    { name: 'ArgoCD', logo: 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/argo-cd.svg' },
    { name: 'GitHub/Actions', logo: 'https://icon.icepanel.io/Technology/svg/GitHub.svg' },
    { name: 'GitLab/CI', logo: 'https://icon.icepanel.io/Technology/svg/GitLab.svg' },
    { name: 'Keycloak', logo: 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/keycloak.svg' },
    { name: 'Vault', logo: 'https://icon.icepanel.io/Technology/svg/HashiCorp-Vault.svg' },
    {
        name: 'NeuVector',
        logo: 'https://www.suse.com/c/wp-content/uploads/2024/01/NeuVector_symbol_horizontal_color.jpg',
    },
    { name: 'CNPG', logo: 'https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/cloud-native-pg.svg' },
    { name: 'Prometheus', logo: 'https://icon.icepanel.io/Technology/svg/Prometheus.svg' },
    { name: 'Grafana', logo: 'https://icon.icepanel.io/Technology/svg/Grafana.svg' },
    { name: 'External-DNS', logo: 'https://kubernetes-sigs.github.io/external-dns/latest/docs/img/external-dns.png' },
    { name: 'External-Secrets', logo: 'https://external-secrets.io/latest/pictures/eso-round-logo.svg' },
    { name: 'Docker/Compose', logo: 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/docker.svg' },
];
---

<section class="flex min-h-screen items-center px-4 py-16" id="skills">
    <div class="mx-auto w-full max-w-300 rounded-2xl bg-white/10 p-4 shadow-2xl sm:p-12">
        <h2 class="mt-2 mb-4 text-center font-title text-3xl leading-8 sm:text-4xl sm:leading-16 lg:text-6xl">
            Technical Skills
        </h2>
        <div class="mb-8">
            <h3 class="mt-2 mb-4 font-title text-2xl md:text-3xl lg:text-4xl">Programming Languages & Frameworks</h3>
            <div class="flex items-center gap-2 justify-self-center">
                <button
                    class="h-9 w-6 flex-none rounded-full bg-white text-center hover:cursor-pointer hover:bg-pswhite"
                    data-scroll-target="prog-skills"
                    data-scroll-direction="left">&lt;</button
                >
                <div
                    id="prog-skills"
                    class="flex w-62.5 flex-none snap-x snap-mandatory justify-self-center overflow-x-scroll sm:w-125 sm:scroll-pl-5 lg:w-187.5 lg:scroll-pl-3.75 2xl:w-250 2xl:scroll-pl-2.5"
                >
                    {
                        softwareSkills.map((skill) => (
                            <div class="mx-7.5 my-4 flex w-50 shrink-0 snap-center flex-col items-center gap-2 rounded-lg bg-white p-1 shadow-lg sm:snap-start">
                                <img src={skill.logo} alt={skill.name} class="h-16 w-16 object-contain" />
                                <span class="text-sm text-nowrap sm:text-base">{skill.name}</span>
                            </div>
                        ))
                    }
                </div>
                <button
                    class="h-9 w-6 flex-none rounded-full bg-white text-center hover:cursor-pointer hover:bg-pswhite"
                    data-scroll-target="prog-skills"
                    data-scroll-direction="right">&gt;</button
                >
            </div>
        </div>

        <div class="mb-8">
            <h3 class="mt-2 mb-4 font-title text-2xl md:text-3xl lg:text-4xl">Cloud Platforms & Tools</h3>
            <div class="flex items-center gap-2 justify-self-center">
                <button
                    class="h-9 w-6 flex-none rounded-full bg-white text-center hover:cursor-pointer hover:bg-pswhite"
                    data-scroll-target="devops-skills"
                    data-scroll-direction="left">&lt;</button
                >
                <div
                    id="devops-skills"
                    class="flex w-62.5 flex-none snap-x snap-mandatory justify-self-center overflow-x-scroll sm:w-125 sm:scroll-pl-5 lg:w-187.5 lg:scroll-pl-3.75 2xl:w-250 2xl:scroll-pl-2.5"
                >
                    {
                        cloudSkills.map((skill) => (
                            <div class="mx-7.5 my-4 flex w-50 shrink-0 snap-center flex-col items-center gap-2 rounded-lg bg-white p-1 shadow-lg sm:snap-start">
                                <img src={skill.logo} alt={skill.name} class="h-16 w-16 object-contain" />
                                <span class="text-sm text-nowrap sm:text-base">{skill.name}</span>
                            </div>
                        ))
                    }
                </div>
                <button
                    class="h-9 w-6 flex-none rounded-full bg-white text-center hover:cursor-pointer hover:bg-pswhite"
                    data-scroll-target="devops-skills"
                    data-scroll-direction="right">&gt;</button
                >
            </div>
        </div>

        <div class="mb-8">
            <h3 class="mt-2 mb-4 font-title text-2xl md:text-3xl lg:text-4xl">Devops Tools & Software</h3>
            <div class="flex items-center gap-2 justify-self-center">
                <button
                    class="h-9 w-6 flex-none rounded-full bg-white text-center hover:cursor-pointer hover:bg-pswhite"
                    data-scroll-target="other-skills"
                    data-scroll-direction="left">&lt;</button
                >
                <div
                    id="other-skills"
                    class="flex w-62.5 flex-none snap-x snap-mandatory justify-self-center overflow-x-scroll sm:w-125 sm:scroll-pl-5 lg:w-187.5 lg:scroll-pl-3.75 2xl:w-250 2xl:scroll-pl-2.5"
                >
                    {
                        devopsSkills.map((skill) => (
                            <div class="mx-7.5 my-4 flex w-50 shrink-0 snap-center flex-col items-center gap-2 rounded-lg bg-white p-1 shadow-lg sm:snap-start">
                                {isImageMetadata(skill.logo) ? (
                                    <Image
                                        src={skill.logo}
                                        alt={skill.name}
                                        width={64}
                                        height={64}
                                        class="h-16 w-16 object-contain"
                                    />
                                ) : (
                                    <img src={skill.logo} alt={skill.name} class="h-16 w-16 object-contain" />
                                )}
                                <span class="text-sm text-nowrap sm:text-base">{skill.name}</span>
                            </div>
                        ))
                    }
                </div>
                <button
                    class="h-9 w-6 flex-none rounded-full bg-white text-center hover:cursor-pointer hover:bg-pswhite"
                    data-scroll-target="other-skills"
                    data-scroll-direction="right">&gt;</button
                >
            </div>
        </div>
    </div>
</section>

<script>
    const SCROLL_OFFSET = 260;

    document.querySelectorAll('button[data-scroll-target]').forEach((button) => {
        button.addEventListener('click', () => {
            const targetId = button.getAttribute('data-scroll-target');
            const direction = button.getAttribute('data-scroll-direction');

            if (!targetId || !direction) {
                return;
            }

            const scroller = document.getElementById(targetId);
            if (!scroller) {
                return;
            }

            const multiplier = direction === 'left' ? -1 : 1;
            scroller.scrollBy({ left: SCROLL_OFFSET * multiplier, behavior: 'smooth' });
        });
    });
</script>
