---
import { Image } from 'astro:assets';
import myPicture from '../lib/assets/pictures/antonin-suzor.jpg';
---

<section class="flex min-h-screen items-center px-2 py-12 sm:px-4 sm:py-16 lg:px-8">
    <div
        class="mx-auto grid items-center gap-4 p-4 sm:grid-cols-1 sm:gap-8 lg:grid-cols-[auto_2px_auto] lg:gap-16 lg:p-8"
    >
        <div
            class="aspect-square w-[min(85vw,70vh)] justify-self-center overflow-hidden rounded-full shadow-xl lg:w-full lg:max-w-xl"
        >
            <Image
                class="h-full w-full object-cover"
                src={myPicture}
                alt="Antonin Suzor"
                format="webp"
                widths={[320, 480, 640, 840]}
                sizes="(max-width: 1024px) min(85vw, 70vh), 40vw"
                quality={80}
                loading="eager"
                decoding="async"
            />
        </div>
        <div class="hidden lg:inline lg:h-68.75 lg:w-1 lg:bg-sv"></div>
        <div class="text-center">
            <h1
                class="justify-self-center font-title text-5xl leading-12 sm:text-6xl sm:leading-16 lg:text-6xl lg:leading-20 xl:text-7xl xl:leading-24"
            >
                Antonin Suzor
            </h1>
            <h2
                class="mt-2 justify-self-center font-title text-2xl leading-6 sm:text-3xl sm:leading-8 lg:text-4xl lg:leading-12 xl:text-5xl xl:leading-16"
            >
                Software, Cloud &amp; DevOps Engineer
            </h2>
            <p class="mb-4 justify-self-center font-main text-base italic sm:text-lg lg:text-xl">
                <span class="text-nowrap">Site reliability engineer</span>
                <span class="text-nowrap"
                    >@ <a
                        class="hover:underline"
                        href="https://www.theodo.com/en-fr/expertise/cloud"
                        target="_blank"
                        rel="noopener external">Theodo Cloud</a
                    ></span
                >
            </p>
            <div class="mt-4 max-w-3xl justify-self-center font-main text-xl text-sv italic lg:text-lg xl:text-xl">
                <strong>Excellence, Communication, and Meticulousness</strong> are my guiding principles when designing, engineering,
                automating and deploying software, be it for long-standing or brand-new projects.<br />
                Currently looking for a full-time position starting in September.
            </div>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
                <a
                    href="/Antonin-Suzor-Resume.pdf"
                    class="text-md rounded-md border-2 border-transparent bg-pswhite px-4 py-4 font-bold tracking-wide text-sv uppercase transition-all duration-300 ease-in-out hover:-translate-y-1 hover:border-sv hover:shadow-xl sm:text-lg lg:px-8 lg:text-xl"
                    target="_blank"
                    rel="noopener">Download Resume (EN)</a
                >
                <a
                    href="/Antonin-Suzor-CV.pdf"
                    class="text-md rounded-md border-2 border-transparent bg-pswhite px-4 py-4 font-bold tracking-wide text-sv uppercase transition-all duration-300 ease-in-out hover:-translate-y-1 hover:border-sv hover:shadow-xl sm:text-lg lg:px-8 lg:text-xl"
                    target="_blank"
                    rel="noopener">Télécharger le CV (FR)</a
                >
            </div>
        </div>
    </div>
</section>
