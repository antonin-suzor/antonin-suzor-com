#!/bin/sh
# Auto-format staged files with Prettier, then re-stage them.
# Enable once per clone with:  git config core.hooksPath .githooks

# Nothing staged? nothing to do.
git diff --cached --name-only --diff-filter=ACM | grep -q . || exit 0

# NUL-delimited throughout so paths with spaces/newlines survive.
git diff --cached --name-only --diff-filter=ACM -z | xargs -0 bunx prettier --write --ignore-unknown
git diff --cached --name-only --diff-filter=ACM -z | xargs -0 git add

exit 0
